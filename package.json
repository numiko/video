{
  "name": "@numiko/video",
  "description": "Initialise and control videos currently supporting HTML5, YouTube and Vimeo.",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org:numiko/video.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "generate-docs": "typedoc src/main.ts --plugin typedoc-plugin-markdown --mergeReadme true --readme none --plugin typedoc-plugin-mdn-links",
    "release": "release-it"
  },
  "main": "./dist/Video.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/Video.d.ts",
      "import": "./dist/Video.es.js",
      "require": "./dist/Video.umd.js"
    }
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^24.7.2",
    "@types/youtube": "^0.1.2",
    "@vimeo/player": "^2.29.7",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "happy-dom": "^15.7.4",
    "release-it": "^17.10.0",
    "timing-object": "^3.1.94",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.2.12",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^2.1.3"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run build"
      ]
    }
  }
}
