{
  "name": "@numiko/video",
  "description": "Initialise and control videos currently supporting HTML5, YouTube and Vimeo.",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org:numiko/video.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "release": "release-it"
  },
  "main": "./dist/Video.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/Video.d.ts",
      "import": "./dist/Video.es.js",
      "require": "./dist/Video.umd.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.10.0",
    "happy-dom": "^21.0.4",
    "release-it": "^21.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^5.0.5"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run build"
      ]
    }
  }
}
