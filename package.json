{
  "name": "@numiko/video",
  "description": "Initialise and control videos currently supporting HTML5, YouTube and Vimeo.",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@ssh.bitbucket.org:numiko/video.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "generate-docs": "typedoc lib/Video.ts",
    "deploy-docs": "netlify deploy --dir=docs --site=abb62b7d-c4b7-48d5-a9de-2ff0e7a7ea26 --alias=v$(node -p \"require('./package.json').version\") && netlify deploy --dir=docs --site=abb62b7d-c4b7-48d5-a9de-2ff0e7a7ea26 --prod",
    "release": "release-it"
  },
  "main": "./dist/Video.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/Video.d.ts",
      "import": "./dist/Video.es.js",
      "require": "./dist/Video.umd.js"
    }
  },
  "devDependencies": {
    "@j-ulrich/release-it-regex-bumper": "^5.3.0",
    "@playwright/test": "^1.50.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/youtube": "^0.1.2",
    "@vimeo/player": "^2.30.0",
    "eslint": "^9.39.5",
    "globals": "^17.10.0",
    "netlify-cli": "^27.16.3",
    "release-it": "^21.0.2",
    "timing-object": "^3.1.94",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-eslint": "^1.8.1"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "plugins": {
      "@j-ulrich/release-it-regex-bumper": {
        "out": [
          {
            "file": "README.md",
            "search": "\\d+-\\d+-\\d+",
            "replace": "{{major}}-{{minor}}-{{patch}}"
          }
        ]
      }
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--access",
        "public"
      ]
    },
    "hooks": {
      "before:init": [
        "playwright test"
      ],
      "after:bump": [
        "npm run generate-docs",
        "npm run build",
        "npm run deploy-docs"
      ]
    }
  }
}
