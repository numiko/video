{
  "include": ["./src/**/*", "./lib/**/*"],
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "noEmit": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "types": ["vitest/globals"]
  }
}
